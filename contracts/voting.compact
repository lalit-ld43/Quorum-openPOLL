// Quorum — anonymous ballots, publicly verifiable tallies
// Midnight Builder Challenge — Level 3 (First Quarter)
//
// PRIVACY MODEL
//   PUBLIC   : poll metadata, live per-option tally counts, the set of
//              spent nullifiers, poll open/closed status.
//   PRIVATE  : the voter's registration secret, which option they chose
//              is proved-then-discarded inside the circuit — only the
//              *aggregate* counter for that option is mutated on-chain.
//   PROVED WITHOUT REVEALING: that the caller holds a valid registration
//              credential for this poll and has not voted before,
//              without revealing which credential, or which option,
//              belongs to which voter.

pragma language_version >= 0.16;

import CompactStandardLibrary;

// ---------------------------------------------------------------------
// Ledger (all fields below are PUBLIC on-chain state)
// ---------------------------------------------------------------------

export ledger pollTitle: Opaque<"string">;
export ledger optionLabels: Vector<4, Opaque<"string">>;
export ledger optionCount: Uint<8>;                 // how many options are live (2-4)
export ledger tallies: Map<Uint<8>, Counter>;        // optionIndex -> vote count
export ledger nullifiers: Set<Bytes<32>>;            // spent-ballot markers
export ledger eligibilityRoot: Bytes<32>;            // Merkle root of eligible-voter commitments
export ledger isOpen: Boolean;
export ledger totalBallots: Counter;

// ---------------------------------------------------------------------
// Witnesses (PRIVATE — supplied locally by the voter, never transmitted)
// ---------------------------------------------------------------------

witness voterSecret(): Bytes<32>;
witness voterMerklePath(): MerkleTreePath<10, Bytes<32>>;

// ---------------------------------------------------------------------
// Circuits
// ---------------------------------------------------------------------

// Poll creator opens a poll with 2-4 options and an eligibility root
// (root of a Merkle tree of hashed voter-registration commitments).
export circuit createPoll(
  title: Opaque<"string">,
  labels: Vector<4, Opaque<"string">>,
  numOptions: Uint<8>,
  root: Bytes<32>
): [] {
  assert(numOptions >= 2 && numOptions <= 4, "poll needs 2-4 options");
  pollTitle = title;
  optionLabels = labels;
  optionCount = numOptions;
  eligibilityRoot = root;
  isOpen = true;
  for (const i of 0..4) {
    if (i < (numOptions as Uint<32>)) {
      tallies.insert(i as Uint<8>, default<Counter>);
    }
  }
}

// Cast an anonymous ballot. The voter proves, in zero-knowledge:
//   1) their secret hashes into a leaf that is a member of eligibilityRoot
//   2) the nullifier derived from that secret + pollTitle has not been used
// Only the chosen option's PUBLIC counter is incremented. Nothing linking
// this transaction to the voter's identity, or the voter to their choice,
// is ever written to the ledger.
export circuit castBallot(chosenOption: Uint<8>): [] {
  assert(isOpen, "poll is closed");
  assert(chosenOption < optionCount, "invalid option");

  const secret = voterSecret();
  const path = voterMerklePath();

  const leaf = persistentHash<Bytes<32>>(secret);
  const computedRoot = merkleTreePathRoot<10, Bytes<32>>(path, leaf);
  assert(computedRoot == eligibilityRoot, "not an eligible voter");

  const nullifier = persistentHash<Vector<2, Bytes<32>>>(
    [secret, persistentHash<Opaque<"string">>(pollTitle)]
  );
  assert(!nullifiers.member(nullifier), "ballot already cast");
  nullifiers.insert(nullifier);

  const current = tallies.lookup(disclose(chosenOption));
  tallies.insert(disclose(chosenOption), current.increment(1));
  totalBallots.increment(1);
}

// Poll creator closes voting. Tallies remain exactly as they are —
// closing does not reveal anything new, it only freezes further ballots.
export circuit closePoll(): [] {
  assert(isOpen, "already closed");
  isOpen = false;
}
